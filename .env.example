# Gere com: openssl rand -base64 32
AUTH_SECRET=

# URL pública do site (usada pelo NextAuth para gerar links/callbacks corretos)
# Em produção, use a URL/IP real do servidor, ex: http://192.168.1.50 ou https://clube.seudominio.com
AUTH_URL=http://localhost:3000

# Opcional: ativa autocomplete de endereço na tela de encontros (admin).
# Sem essa chave, o campo "Local" continua funcionando normalmente como texto livre.
# Crie uma chave em https://console.cloud.google.com/google/maps-apis/credentials,
# habilite "Places API" e "Maps JavaScript API", e restrinja a chave por domínio/referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
